;; openicc — the analytic core is dependency-free on purpose.
;;
;; `src/` requires nothing but the language. That is not minimalism for its own
;; sake: it is what lets the whole pipeline run under nbb and, later, under the
;; Kotoba/WASM guest, which is the runtime order CLAUDE.md sets. A consensus
;; dependency on the default classpath would pin this library to the JVM and
;; make the test suite need a network.
;;
;; The consensus plane is a PROVIDER, enabled explicitly:
;;
;;   kbb -M:inga ...        the inga-backed quorum
;;   kbb --backend sci run_tests.cljk         the core suite, no deps, no network
;;
;; Reference rule (manifest/layers.edn): workspace-internal deps are
;; :local/root relative, and the version authority is the west pin.
{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}

 :aliases
 {;; The only alias that reaches a consensus implementation. Exactly one
  ;; namespace lives behind it (openicc.chain.inga) — a second quorum
  ;; implementation would be a second answer to the question the consensus
  ;; plane exists to answer.
  ;;   kbb -M:inga:test -d test -d test-inga
  :inga {:extra-paths ["src-inga" "test-inga"]
         :extra-deps {io.github.kotoba-lang/inga
                      {:local/root "../../kotoba-lang/inga"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "src-inga" "test"
                        "--fail-level" "error"]}}}
